# Required to enable admin login. Use a long, unique password and keep this file private.
QELVAIRO_ADMIN_PASSWORD= Midhun

# Optional public contact details shown in the footer and used for the email fallback.
QELVAIRO_CONTACT_EMAIL=
QELVAIRO_CONTACT_PHONE=
QELVAIRO_INSTAGRAM_URL=
QELVAIRO_LINKEDIN_URL=

# Optional. Defaults to ./data, outside the built website files.
QELVAIRO_DATA_DIR=

# Server settings
PORT=4173
NODE_ENV=development
